rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each authenticated user has exclusive read and write access to their own data tree
    // User document: users/{userId}
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // All nested subcollections: users/{userId}/{subcollection}/{docId}
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
